# Copiá este archivo como .env y completalo. El .env nunca se sube al repo.

# Cadena de conexión de Neon (rama "desarrollo" en local, "production" en Render)
DATABASE_URL=
# Base solo para las pruebas (rama "tests" de Neon o un PostgreSQL local). Se vacía en cada corrida.
TEST_DATABASE_URL=
# Al menos 32 caracteres al azar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
TERMINOS_VERSION=1.0
NODE_ENV=development
PORT=3000
# Proxies delante del backend (0 en local; se ajusta al desplegar)
TRUST_PROXY=0

# Correo (RF-03). Si SMTP_HOST queda vacío, los correos se muestran en la consola.
# Producción: Brevo (smtp-relay.brevo.com) en el puerto 2525, porque Render gratis bloquea 25, 465 y 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TucuMaps <no-responder@tucumaps.local>

# Límites de RF-09 (Sprint 3)
LIMITE_REPORTES_DIA=5
LIMITE_EVENTOS_DIA=3
